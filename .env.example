# ============================================================
#  ROOMLY — Variables d'environnement
#  (ce fichier .env.example est un MODELE : copiez-le en .env et remplissez-le)
# ============================================================

# ---- Base de données : MongoDB LOCAL ------------------------
# Prisma exige un "replica set", même avec un seul serveur.
# Voir scripts/setup-mongodb-replicaset.ps1 et `npm run db:init`.
DATABASE_URL="mongodb://127.0.0.1:27017/roomly?replicaSet=rs0"

# ---- Ancienne base MongoDB Atlas (LECTURE SEULE) ------------
# Sert uniquement une fois, pour rapatrier les données existantes
# vers le PC via `npm run db:migrate`. Jamais modifiée.
ATLAS_DATABASE_URL=""

# Adresse Atlas "directe" : secours si votre reseau bloque les requetes DNS SRV.
ATLAS_DATABASE_URL_DIRECT=""

# ---- Authentification (NextAuth) ----------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="remplacez-moi-par-une-chaine-aleatoire"

# Connexion Google (optionnelle : nécessite Internet).
# Laisser vide pour désactiver le bouton "Continuer avec Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Paiement en ligne : Konnect (mode test / preprod) ------
# SEUL service qui sort d'Internet. La clé reste côté serveur.
# Format de la clé : <walletId>:<secret>
KONNECT_API_URL="https://api.preprod.konnect.network/api/v2"
KONNECT_API_KEY="votre-identifiant:votre-secret"
KONNECT_WALLET_ID="votre-numero-de-portefeuille"

# ---- Adresse publique du site (retours de paiement) ---------
BASE_URL="http://localhost:3000"

# ---- Comptes de démonstration créés par `npm run db:seed` ---
SEED_ADMIN_EMAIL="admin@roomly.com"
SEED_ADMIN_PASSWORD="admin123"
SEED_USER_PASSWORD="roomly123"
